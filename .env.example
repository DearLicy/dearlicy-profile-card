PORT=3410
HOST=0.0.0.0
DATA_DIR=./data

# Required. Generate with: openssl rand -hex 32
ADMIN_SECRET=replace-with-at-least-24-random-characters

# Optional. A read-only token raises the API limit and enables GraphQL.
GITHUB_TOKEN=

# Initial defaults. Values saved in /admin override these.
DEFAULT_USERNAME=DearLicy
SITE_MODE=public
PUBLIC_REPO_URL=https://github.com/DearLicy/dearlicy-profile-card

# Optional. Can also be configured from the admin UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
