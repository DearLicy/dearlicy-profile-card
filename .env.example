PORT=3410
HOST=0.0.0.0
DATA_DIR=./data

# Image library storage: "file" keeps WebP files under DATA_DIR; "google-drive"
# stores images and the manifest in Google Drive instead. Setting
# GOOGLE_DRIVE_FOLDER_ID also selects Google Drive automatically.
IMAGE_STORAGE_DRIVER=file

# Google Drive folder shared with the OAuth account or service account.
# A folder URL copied from the browser is accepted.
GOOGLE_DRIVE_FOLDER_ID=

# Option A: OAuth refresh token generated by
# `npm run google:drive:auth`. Keep all three values server-side.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Option B: service account JSON encoded as one base64 string. Share the
# target Drive folder with the service account email as Editor.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
# Optional delegated user for Workspace domain-wide delegation.
GOOGLE_DRIVE_SUBJECT=

# Required. Generate with: openssl rand -hex 32
ADMIN_SECRET=replace-with-at-least-24-random-characters

# Optional. A read-only token raises the API limit and enables GraphQL.
GITHUB_TOKEN=

# Optional. Keep disabled unless GitHub changes its avatar host and you need to
# allow a trusted replacement host.
ALLOW_REMOTE_ASSET_FETCH=false

# Initial defaults. Values saved in /admin override these.
DEFAULT_USERNAME=DearLicy
SITE_MODE=public
PUBLIC_REPO_URL=https://github.com/DearLicy/dearlicy-profile-card
